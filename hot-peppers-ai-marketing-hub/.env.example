# HOT PEPPERS AI MARKETING HUB – šablona proměnných prostředí
# Zkopírujte do .env (Prisma CLI) a .env.local (Next.js):  cp .env.example .env
# Skutečné hodnoty NIKDY necommitujte. Soubory .env* jsou v .gitignore.

# Lokální SQLite databáze (cesta relativně ke kořeni projektu)
DATABASE_URL="file:./prisma/dev.db"

# --- AI (volitelné; integrace přijde v bloku 6) ---
# Bez klíče aplikace běží v transparentním ne-AI režimu: evidence, dashboard
# a ruční hodnocení fungují, AI akce jsou zřetelně nedostupné.
# Klíč je čten pouze na serveru – nikdy jej neprefixujte NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Model ID ověřte v dokumentaci Anthropic před použitím (nevymýšlejte ID).
ANTHROPIC_MODEL=
